# Copy this file to server/.env and fill it in. server/.env is not in git, so the keys stay on this Mac.

# Email for "confirm your email": an API key from https://resend.com/api-keys
RESEND_API_KEY=

# Optional: the sender as people see it. Until a domain of our own is verified in Resend,
# keep onboarding@resend.dev (and emails only reach the Resend account's own address)
# MAIL_FROM=My Gardrobe <hello@yourdomain.com>

# The server's address as people's phones reach it; used in the link inside the email
# PUBLIC_URL=http://localhost:8001

# Recognising pieces from photos
# ANTHROPIC_API_KEY=
